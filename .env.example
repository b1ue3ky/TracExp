# RPC endpoints with debug_traceTransaction support are required.
ETH_RPC_URL=
BSC_RPC_URL=

# Etherscan-compatible key used for verified contract metadata and ABIs.
ETHERSCAN_API_KEY=

# OpenRouter-compatible LLM endpoint used by PoC synthesis.
TRACEXP_LLM_ENDPOINT=
TRACEXP_LLM_API_KEY=

# Optional HTTP(S) proxy. Standard HTTPS_PROXY is also honored.
HTTPS_PROXY=

# Optional cache and result version override.
TRACEXP_CACHE_DIR=.tracexp_cache
VERSION=1.0.1
